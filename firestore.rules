rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/WanderingBar/main)
        && get(/databases/$(database)/documents/WanderingBar/main).data.ownerUid == request.auth.uid;
    }

    match /WanderingBar/main {
      allow read: if isOwner();
      allow update: if isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow create, delete: if false;

      match /{path=**} {
        allow read, write: if isOwner();
      }
    }

    // Legacy users/{uid} paths intentionally have no allow rule.
  }
}
