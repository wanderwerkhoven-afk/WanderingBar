rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Legacy per-user datasets remain available throughout the copy migration.
    match /users/{userId}/{dataset}/{recordId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && dataset in ['events', 'deletedEvents', 'inventory', 'catalog', 'meta'];
    }

    function owner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/WanderingBar/main)
        && get(/databases/$(database)/documents/WanderingBar/main).data.ownerUid == request.auth.uid;
    }
    match /WanderingBar/main {
      // Bootstrap allowed only to an authenticated user who already owns a
      // legacy initialized workspace; first successful owner claims the root.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/meta/workspace);
      allow read: if owner();
      allow update: if owner() && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
      match /{path=**} {
        allow read, write: if owner();
      }
    }
  }
}
